      "id": "4a59f560-daae-4013-a930-f929e10c7071",
      "name": "My Candidate Profile",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        224
      ]
    },
    {
      "parameters": {
        "url": "https://himalayas.app/jobs/api/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "junior software developer"
            }
          ]
        },
        "options": {}
